generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PromotionType {
  CATEGORY_PERCENTAGE
  PRODUCT_COMBO
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  SEARCH
  SEARCH_NO_RESULTS
  ADD_TO_CART
  REMOVE_FROM_CART
  WHATSAPP_CLICK
  ORDER_SENT_TO_WHATSAPP
  PROMOTION_VIEW
  CATEGORY_VIEW
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@index([active])
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model Category {
  id              String                   @id @default(cuid())
  name            String                   @unique
  slug            String                   @unique
  displayOrder    Int                      @default(0)
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  products        Product[]
  promotions      Promotion[]
  characteristics CategoryCharacteristic[]

  @@index([active, displayOrder])
}

model Product {
  id            String             @id @default(cuid())
  categoryId    String
  description   String
  slug          String             @unique
  specification String
  priceInCents  Int
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  promotions    PromotionProduct[]
  variants      ProductVariant[]

  @@index([categoryId])
  @@index([active])
  @@index([categoryId, active])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  publicId     String
  altText      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model Characteristic {
  id           String                   @id @default(cuid())
  name         String                   @unique
  slug         String                   @unique
  displayOrder Int                      @default(0)
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  options      CharacteristicOption[]
  categories   CategoryCharacteristic[]
  values       ProductVariantValue[]

  @@index([active, displayOrder])
}

model CharacteristicOption {
  id               String                @id @default(cuid())
  characteristicId String
  name             String
  slug             String
  displayOrder     Int                   @default(0)
  active           Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  characteristic   Characteristic        @relation(fields: [characteristicId], references: [id], onDelete: Cascade)
  values           ProductVariantValue[]

  @@unique([characteristicId, name])
  @@unique([characteristicId, slug])
  @@unique([id, characteristicId])
  @@index([characteristicId, active, displayOrder])
}

model CategoryCharacteristic {
  categoryId       String
  characteristicId String
  displayOrder     Int            @default(0)
  required         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@id([categoryId, characteristicId])
  @@index([categoryId, displayOrder])
  @@index([characteristicId])
}

model ProductVariant {
  id              String                @id @default(cuid())
  productId       String
  sku             String                @unique
  optionSignature String
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          ProductVariantValue[]
  images          ProductVariantImage[]

  @@unique([productId, optionSignature])
  @@index([productId])
  @@index([productId, active])
  @@index([active])
}

model ProductVariantValue {
  productVariantId       String
  characteristicId       String
  characteristicOptionId String
  createdAt              DateTime             @default(now())
  productVariant         ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  characteristic         Characteristic       @relation(fields: [characteristicId], references: [id], onDelete: Restrict)
  characteristicOption   CharacteristicOption @relation(fields: [characteristicOptionId, characteristicId], references: [id, characteristicId], onDelete: Restrict)

  @@id([productVariantId, characteristicId])
  @@unique([productVariantId, characteristicOptionId])
  @@index([characteristicId])
  @@index([characteristicOptionId])
}

model ProductVariantImage {
  id               String         @id @default(cuid())
  productVariantId String
  url              String
  publicId         String
  altText          String?
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId, displayOrder])
}

model Promotion {
  id                String             @id @default(cuid())
  type              PromotionType
  description       String
  slug              String             @unique
  categoryId        String?
  percentage        Int?
  comboPriceInCents Int?
  active            Boolean            @default(true)
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products          PromotionProduct[]
  images            PromotionImage[]

  @@index([type])
  @@index([active])
  @@index([categoryId])
  @@index([startsAt, endsAt])
}

model PromotionProduct {
  promotionId  String
  productId    String
  displayOrder Int       @default(0)
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([promotionId, productId])
  @@index([productId])
  @@index([promotionId, displayOrder])
}

model PromotionImage {
  id           String    @id @default(cuid())
  promotionId  String
  url          String
  publicId     String
  altText      String?
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, displayOrder])
}

model Banner {
  id                  String   @id @default(cuid())
  imageUrl            String
  imagePublicId       String
  mobileImageUrl      String?
  mobileImagePublicId String?
  redirectUrl         String
  altText             String?
  displayOrder        Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active, displayOrder])
}

model AnalyticsEvent {
  id                   String             @id @default(cuid())
  type                 AnalyticsEventType
  sessionId            String
  productId            String?
  productVariantId     String?
  promotionId          String?
  categoryId           String?
  searchTerm           String?
  searchTermNormalized String?
  resultsCount         Int?
  pagePath             String
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmTerm              String?
  utmContent           String?
  createdAt            DateTime           @default(now())

  @@index([type, createdAt])
  @@index([sessionId, createdAt])
  @@index([productId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([promotionId, createdAt])
  @@index([categoryId, createdAt])
  @@index([searchTermNormalized, createdAt])
  @@index([utmSource, utmMedium, utmCampaign])
  @@index([createdAt])
}

model StoreSettings {
  id                      Int      @id @default(1)
  tradeName               String
  cnpj                    String
  phone                   String
  email                   String
  address                 String
  mapEmbedUrl             String
  aboutText               String
  whatsappNumber          String
  whatsappInitialMessage  String
  bannerTransitionSeconds Int      @default(5)
  logoUrl                 String?
  logoPublicId            String?
  darkLogoUrl             String?
  darkLogoPublicId        String?
  lightPrimaryColor       String
  lightBackgroundColor    String
  lightTextColor          String
  darkPrimaryColor        String
  darkBackgroundColor     String
  darkTextColor           String
  updatedAt               DateTime @updatedAt
}
